{UTF-8}
A = 0.25
      ~
      ~       |

B = 0.33
      ~
      ~       |

Backlog = INTEG(bFlow,0)
      ~
      ~       |

Backlog 0 = INTEG(bFlow 0,0)
      ~
      ~       |

Backlog 1 = INTEG(bFlow 1,0)
      ~
      ~       |

Backlog 2 = INTEG(bFlow 2,0)
      ~
      ~       |

bFlow = ORDer-sold
      ~
      ~       |

bFlow 0 = ordered-sold 0
      ~
      ~       |

bFlow 1 = ordered 0-sold 1
      ~
      ~       |

bFlow 2 = ordered 1-sold 2
      ~
      ~       |

coming = ordered 2
      ~
      ~       |

Cost = INTEG(cost increase,0)
      ~
      ~       |

cost increase = 1*(Backlog+Backlog 0+Backlog 1+Backlog 2)+0.5*(Inventory+Inventory 0
+Inventory 1+Inventory 2)
      ~
      ~       |

Eff Env = Inventory-Backlog
      ~
      ~       |

Eff Inv 0 = Inventory 0-Backlog 0
      ~
      ~       |

Eff Inv 1 = Inventory 1-Backlog 1
      ~
      ~       |

Eff Inv 2 = Inventory 2-Backlog 2
      ~
      ~       |

FINAL TIME  = 36
      ~ week
      ~ The final time for the simulation.
      |

in = DELAY FIXED(sold 0,2,4)
      ~
      ~       |

in 0 = DELAY FIXED(sold 1,2,4)
      ~
      ~       |

in 1 = DELAY FIXED(sold 2,2,4)
      ~
      ~       |

in 2 = DELAY FIXED(coming,2,4)
      ~
      ~       |

INITIAL TIME  = 0
      ~ week
      ~ The initial time for the simulation.
      |

Inventory = INTEG(in-sold,12)
      ~
      ~       |

Inventory 0 = INTEG(in 0-sold 0,12)
      ~
      ~       |

Inventory 1 = INTEG(in 1-sold 1,12)
      ~
      ~       |

Inventory 2 = INTEG(in 2-sold 2,12)
      ~
      ~       |

ORDer = 4+STEP(4,5)
      ~
      ~       |

ordered = DELAY FIXED(placed,1,4)
      ~
      ~       |

ordered 0 = DELAY FIXED(placed 0,1,4)
      ~
      ~       |

ordered 1 = DELAY FIXED(placed 1,1,4)
      ~
      ~       |

ordered 2 = DELAY FIXED(placed 2,1,4)
      ~
      ~       |

placed = MAX(
  0,SMOOTH(ORDer,SMOOTHTIME)+A*(12-(Inventory-Backlog)-B*SupplyL))
      ~
      ~       |

placed 0 = MAX(
  0,SMOOTH(ordered,SMOOTHTIME)+A*(12-(Inventory 0-Backlog 0)-B*SupplyL 0))
      ~
      ~       |

placed 1 = MAX(
  0,SMOOTH(ordered 0,SMOOTHTIME)+A*(12-(Inventory 1-Backlog 1)-B*SupplyL 1))
      ~
      ~       |

placed 2 = MAX(
  0,SMOOTH(ordered 1,SMOOTHTIME)+A*(12-(Inventory 2-Backlog 2)-B*SupplyL 2))
      ~
      ~       |

SAVEPER  =
        TIME STEP
      ~ week
      ~ The frequency with which output is stored.
      |

sFlow = placed-in
      ~
      ~       |

sFlow 0 = placed 0-in 0
      ~
      ~       |

sFlow 1 = placed 1-in 1
      ~
      ~       |

sFlow 2 = placed 2-in 2
      ~
      ~       |

SMOOTHTIME=
	 1
      ~
      ~       |

sold = MIN(Inventory+in,ORDer+Backlog)
      ~
      ~       |

sold 0 = MIN(Inventory 0+in 0,ordered+Backlog 0)
      ~
      ~       |

sold 1 = MIN(Inventory 1+in 1,ordered 0+Backlog 1)
      ~
      ~       |

sold 2 = MIN(Inventory 2+in 2,ordered 1+Backlog 2)
      ~
      ~       |

SupplyL = INTEG(sFlow,0)
      ~
      ~       |

SupplyL 0 = INTEG(sFlow 0,0)
      ~
      ~       |

SupplyL 1 = INTEG(sFlow 1,0)
      ~
      ~       |

SupplyL 2 = INTEG(sFlow 2,0)
      ~
      ~       |

TIME STEP  = 1
      ~ week
      ~ The time step for the simulation.
      |

